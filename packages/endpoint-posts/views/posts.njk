{% extends "document.njk" %}

{% block content %}
  {% call details({
    summary: __("posts.posts.filter"),
    open: isFiltered
  }) %}
    <form method="get" action="{{ parentUrl }}" role="search">
      {{ checkboxes({
        name: "post-type",
        values: postTypes,
        fieldset: {
          legend: __("posts.posts.postType")
        },
        items: postTypeItems
      }) | indent(6) }}
      {{ input({
        name: "filter",
        type: "search",
        label: __("posts.posts.filter"),
        value: filter
      }) }}
      {{ button({
        classes: "button--secondary",
        text: __("posts.posts.submit")
      }) }}
    </form>
  {% endcall %}
  {% call section({ id: "posts", title: listSummary | escape }) %}
    {%- if posts | length > 0 %}
    {{ cardGrid({
      cardSize: "16rem",
      items: posts
    }) }}
    {{ pagination(cursor) }}
    {%- endif %}
  {% endcall %}
{% endblock %}
