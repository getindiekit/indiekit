{% extends "document.njk" %}

{% set endpoints = {
  authorization_endpoint: application.authorizationEndpoint,
  token_endpoint: application.tokenEndpoint,
  micropub: application.micropubEndpoint,
  microsub: application.microsubEndpoint,
  "share-url": application.shareEndpoint + "?url={url}&name={title}&content={text}"
} %}

{% set discovery %}
{{ __("guidance.discovery", application.name) | safe }}

```html
{% for rel, href in endpoints %}
{% if href %}
<link rel="{{ rel }}" href="{{ href | safe }}">
{% endif %}
{% endfor %}
```
{% endset %}

{% block content %}
  {{ section({
    id: "discovery",
    text: discovery
  }) }}

<div class="widget-grid">
{% for plugin in installedPlugins -%}
  {% include plugin.id + "-widget.njk" ignore missing %}
{%- endfor %}
</div>

{% endblock %}